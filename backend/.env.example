# Application
APP_ENV=development
APP_NAME=FreightFlex API
SECRET_KEY=change-this-secret-key-in-production

# Database
DATABASE_URL=mysql+pymysql://freightflex:password@localhost:3306/freightflex?charset=utf8mb4

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (RS256 — generate with: openssl genrsa -out private.pem 2048)
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ACCESS_TOKEN_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_DAYS=30

# AWS S3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET_DOCS=freightflex-docs
AWS_S3_BUCKET_INVOICES=freightflex-invoices

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Email (SendGrid)
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_EMAIL=noreply@freightflex.io

# Firebase (Push Notifications)
FCM_SERVER_KEY=your-fcm-server-key

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
